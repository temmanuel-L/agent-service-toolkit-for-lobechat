FROM python:3.12.3-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1
ENV PYTHONPATH=".:src"
ENV TZ="Asia/Shanghai"
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"
ENV PIP_TRUSTED_HOST="pypi.tuna.tsinghua.edu.cn"
# 固定 tiktoken 缓存目录，构建阶段预下载后写入镜像，避免运行时首次拉取 cl100k_base 失败
ENV TIKTOKEN_CACHE_DIR="/app/.tiktoken_cache"

COPY pyproject.toml .
COPY uv.lock .
# 使用清华 Debian 源（与 PIP 源一致），避免 apt-get update 走 deb.debian.org 过慢
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    printf '%s\n' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm main contrib non-free non-free-firmware' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm-updates main contrib non-free non-free-firmware' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/debian-security bookworm-security main contrib non-free non-free-firmware' \
      > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    update-ca-certificates; \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
RUN uv sync --frozen --no-install-project --no-dev
# 构建环境常无法访问 openaipublic.blob.core.windows.net（SSL/网络），词表随仓库内置，离线可用
COPY docker/tiktoken-cache/ /app/.tiktoken_cache/
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

COPY src/agents/ ./agents/
COPY src/core/ ./core/
COPY src/memory/ ./memory/
COPY src/rag/ ./rag/
COPY src/schema/ ./schema/
COPY src/service/ ./service/
COPY src/utils/ ./utils/
COPY src/run_service.py .

CMD ["python", "run_service.py"]
